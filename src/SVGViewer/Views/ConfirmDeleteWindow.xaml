<Window x:Class="SVGViewer.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SVGViewer.Localization"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[ConfirmDeleteTitle]}"
        SizeToContent="Height" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,14" />
        <CheckBox x:Name="DoNotAskAgainCheck"
                  Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ConfirmDeleteDoNotAskAgain]}"
                  Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonCancel]}"
                    MinWidth="90" Padding="14,4" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click" />
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ContextDelete]}"
                    MinWidth="90" Padding="14,4" IsDefault="True" Click="Delete_Click" />
        </StackPanel>
    </StackPanel>
</Window>
