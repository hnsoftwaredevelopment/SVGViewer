<Window
    x:Class="SVGViewer.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SVGViewer.Localization"
    Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[AboutTitle]}"
    Width="470"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <StackPanel>

        <!--  Application  -->
        <Grid Margin="24,24,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image
                x:Name="AppLogo"
                Width="88"
                Height="88"
                VerticalAlignment="Top"
                RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="18,2,0,0">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="SVG Viewer" />
                <TextBlock
                    x:Name="VersionText"
                    Margin="0,2,0,0"
                    Opacity="0.6" />
                <TextBlock
                    Margin="0,12,0,0"
                    LineHeight="20"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[AboutDescription]}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  Publisher (dark strip so the white logo reads well)  -->
        <Border
            x:Name="CompanySection"
            Padding="24,16"
            Background="#FDFBF9">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    FontSize="14"
                    Foreground="#4438A1"
                    Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[AboutMadeBy]}" />
                <Image
                    x:Name="CompanyLogo"
                    Height="52"
                    Margin="0,10,0,6"
                    HorizontalAlignment="Left"
                    RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock
                    FontSize="14"
                    FontStyle="Italic"
                    FontWeight="Bold"
                    Foreground="#4438A1"
                    Text="HN Software Development" />

            </StackPanel>
        </Border>

        <!--  Actions  -->
        <Border
            Padding="24,14"
            Background="#F6F8FA"
            BorderBrush="#D8DEE4"
            BorderThickness="0,1,0,0">
            <Button
                MinWidth="90"
                Padding="18,4"
                HorizontalAlignment="Right"
                Click="Close_Click"
                Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonClose]}"
                IsCancel="True"
                IsDefault="True" />
        </Border>

    </StackPanel>
</Window>
