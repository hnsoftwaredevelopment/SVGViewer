<Window x:Class="SVGViewer.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SVGViewer.Localization"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[AboutTitle]}"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <StackPanel>

        <!-- Application -->
        <Grid Margin="24,24,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="AppLogo" Width="88" Height="88"
                   VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="18,2,0,0">
                <TextBlock Text="SVG Viewer" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Opacity="0.6" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[AboutDescription]}"
                           TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20" />
            </StackPanel>
        </Grid>

        <!-- Publisher (dark strip so the white logo reads well) -->
        <Border x:Name="CompanySection" Background="#24303F" Padding="24,16">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[AboutMadeBy]}"
                           Foreground="#AEB9C7" FontSize="12" />
                <Image x:Name="CompanyLogo" Height="52" HorizontalAlignment="Left" Margin="0,10,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Border Background="#F6F8FA" Padding="24,14"
                BorderBrush="#D8DEE4" BorderThickness="0,1,0,0">
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonClose]}"
                    Click="Close_Click" HorizontalAlignment="Right"
                    Padding="18,4" MinWidth="90" IsCancel="True" IsDefault="True" />
        </Border>

    </StackPanel>
</Window>
