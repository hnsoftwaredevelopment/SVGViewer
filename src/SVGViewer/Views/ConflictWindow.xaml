<Window x:Class="SVGViewer.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SVGViewer.Localization"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[ConfirmOverwriteTitle]}"
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,18" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonOverwrite]}"
                    MinWidth="90" Padding="12,4" Margin="0,0,8,0" Click="Overwrite_Click" />
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonOverwriteAll]}"
                    MinWidth="90" Padding="12,4" Margin="0,0,8,0" Click="OverwriteAll_Click" />
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonSkip]}"
                    MinWidth="90" Padding="12,4" Margin="0,0,8,0" IsCancel="True" Click="Skip_Click" />
            <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonSkipAll]}"
                    MinWidth="90" Padding="12,4" Click="SkipAll_Click" />
        </StackPanel>
    </StackPanel>
</Window>
