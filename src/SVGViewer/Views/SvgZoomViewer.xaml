<UserControl x:Class="SVGViewer.Views.SvgZoomViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SVGViewer.Localization"
             Background="#CC101418"
             Visibility="Collapsed"
             Focusable="True">

    <!-- Full-window dimmed overlay hosting one zoomable, pannable SVG. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#1B1F24" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="FileNameText"
                           Foreground="#E6EDF3" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ZoomOutButton" Width="34" Height="28" Margin="2,0"
                            Content="&#x2212;" FontSize="16" Click="ZoomOut_Click"
                            ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerZoomOut]}" />
                    <TextBlock x:Name="ZoomLevelText" Width="56" TextAlignment="Center"
                               Foreground="#E6EDF3" VerticalAlignment="Center" Text="100%" />
                    <Button x:Name="ZoomInButton" Width="34" Height="28" Margin="2,0"
                            Content="+" FontSize="16" Click="ZoomIn_Click"
                            ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerZoomIn]}" />
                    <Button Width="Auto" Height="28" Margin="8,0,2,0" Padding="10,0"
                            Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerZoomReset]}"
                            Click="ZoomReset_Click" />
                    <Button Width="Auto" Height="28" Margin="2,0" Padding="10,0"
                            Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerZoomFit]}"
                            Click="ZoomFit_Click" />
                    <Button Width="34" Height="28" Margin="8,0,0,0"
                            Content="&#x2715;" FontSize="14" Click="Close_Click"
                            ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerClose]}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Canvas: scroll to zoom, drag to pan -->
        <Border Grid.Row="1" ClipToBounds="True" Background="Transparent"
                x:Name="ViewportBorder"
                MouseWheel="Viewport_MouseWheel"
                MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                MouseMove="Viewport_MouseMove">
            <Image x:Name="PreviewImage" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.RenderTransform>
                    <MatrixTransform x:Name="ImageTransform" />
                </Image.RenderTransform>
            </Image>
        </Border>

        <!-- Hint bar -->
        <Border Grid.Row="2" Background="#1B1F24" Padding="12,6">
            <TextBlock Foreground="#8B949E" FontSize="11" HorizontalAlignment="Center"
                       Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerHint]}" />
        </Border>
    </Grid>
</UserControl>
