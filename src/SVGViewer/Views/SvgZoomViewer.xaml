<UserControl
    x:Class="SVGViewer.Views.SvgZoomViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SVGViewer.Localization"
    Background="#CC101418"
    Focusable="True"
    Visibility="Collapsed">

    <!--  Full-window dimmed overlay hosting one zoomable, pannable SVG.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Border
            Grid.Row="0"
            Padding="12,8"
            Background="#1B1F24">
            <DockPanel>
                <TextBlock
                    x:Name="FileNameText"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontSize="13"
                    Foreground="#E6EDF3"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        x:Name="ZoomOutButton"
                        Width="34"
                        Height="28"
                        Margin="2,0"
                        Click="ZoomOut_Click"
                        Content="&#x2212;"
                        FontSize="16"
                        ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerZoomOut]}" />
                    <TextBlock
                        x:Name="ZoomLevelText"
                        Width="56"
                        VerticalAlignment="Center"
                        Foreground="#E6EDF3"
                        Text="100%"
                        TextAlignment="Center" />
                    <Button
                        x:Name="ZoomInButton"
                        Width="34"
                        Height="28"
                        Margin="2,0"
                        Click="ZoomIn_Click"
                        Content="+"
                        FontSize="16"
                        ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerZoomIn]}" />
                    <Button
                        Width="Auto"
                        Height="28"
                        Margin="8,0,2,0"
                        Padding="10,0"
                        Click="ZoomReset_Click"
                        Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerZoomReset]}" />
                    <Button
                        Width="Auto"
                        Height="28"
                        Margin="2,0"
                        Padding="10,0"
                        Click="ZoomFit_Click"
                        Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerZoomFit]}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
        Canvas: scroll to zoom, drag to pan. Solid white so transparent SVGs
        read well and the dimmed window behind never shows through.
        -->
        <Border
            x:Name="ViewportBorder"
            Grid.Row="1"
            Background="White"
            ClipToBounds="True"
            MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
            MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
            MouseMove="Viewport_MouseMove"
            MouseWheel="Viewport_MouseWheel">
            <Image
                x:Name="PreviewImage"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                Stretch="Uniform">
                <Image.RenderTransform>
                    <MatrixTransform x:Name="ImageTransform" />
                </Image.RenderTransform>
            </Image>
        </Border>

        <!--  Hint bar  -->
        <Border
            Grid.Row="2"
            Padding="12,6"
            Background="#1B1F24">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="#8B949E"
                Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[ViewerHint]}" />
        </Border>
    </Grid>
</UserControl>
