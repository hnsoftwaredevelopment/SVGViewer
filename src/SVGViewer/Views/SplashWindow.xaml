<Window x:Class="SVGViewer.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True" Background="Transparent">
    <Grid>
        <Image Source="pack://application:,,,/Assets/splash.png" Width="800" Stretch="Uniform" />

        <!-- Version number overlay (bottom-left). -->
        <Border x:Name="VersionChip"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="20,0,18,16" Padding="10,3"
                CornerRadius="10" Background="#99141A6F">
            <TextBlock x:Name="VersionText"
                       Foreground="#FF8AB8D6" FontSize="13" FontFamily="Boldena" />
        </Border>
    </Grid>
</Window>
