<Window x:Class="SVGViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SVGViewer.Localization"
        xmlns:vm="clr-namespace:SVGViewer.ViewModels"
        xmlns:views="clr-namespace:SVGViewer.Views"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[AppTitle]}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="SvgAccentBrush" Color="#1F6FEB" />
        <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E3EDFD" />

        <!-- Shared right-click menu for an SVG item (thumbnail or list row).
             PlacementTarget.Tag holds the MainViewModel; PlacementTarget's
             DataContext is the SvgFileViewModel used as command parameter. -->
        <ContextMenu x:Key="SvgItemContextMenu" x:Shared="False">
            <MenuItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[ContextOpen]}"
                      Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      FontWeight="SemiBold" />
            <MenuItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[ContextOpenWith]}"
                      Command="{Binding PlacementTarget.Tag.OpenFileWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[ContextShowInExplorer]}"
                      Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>

        <!-- A folder node in the tree; highlighted when it contains SVG files -->
        <HierarchicalDataTemplate x:Key="FolderTemplate"
                                  DataType="{x:Type vm:DirectoryNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="&#x1F4C1;" Margin="0,0,5,0" FontSize="13" />

                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#24292F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSvgFiles}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{StaticResource SvgAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="8"
                        Background="{StaticResource BadgeBackgroundBrush}"
                        ToolTip="{Binding SvgTooltip}"
                        Visibility="{Binding HasSvgFiles, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SvgFileCount}" FontSize="11"
                               Foreground="{StaticResource SvgAccentBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel>

        <!-- ============ Toolbar ============ -->
        <Border DockPanel.Dock="Top" Background="#F6F8FA" Padding="10,8"
                BorderBrush="#D8DEE4" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">

                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[LabelDrive]}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="190" Margin="0,0,18,0"
                          ItemsSource="{Binding Drives}"
                          SelectedItem="{Binding SelectedDrive}"
                          DisplayMemberPath="DisplayName" />

                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[LabelView]}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="200" Margin="0,0,18,0"
                          ItemsSource="{Binding FilterChoices}"
                          SelectedItem="{Binding SelectedFilter}"
                          DisplayMemberPath="DisplayName" />

                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[LabelPreviewSize]}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="140" Margin="0,0,18,0"
                          ItemsSource="{Binding PreviewSizeChoices}"
                          SelectedItem="{Binding SelectedPreviewSize}"
                          DisplayMemberPath="DisplayName" />

                <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonRefresh]}"
                        Command="{Binding RefreshCommand}"
                        Padding="12,3" Margin="0,0,8,0" />

                <Button Command="{Binding CancelScanCommand}"
                        Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonCancel]}"
                        Padding="12,3" Margin="0,0,8,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                <Button Click="Settings_Click" Padding="10,3"
                        Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[SettingsTitle]}"
                        ToolTip="{Binding Source={x:Static loc:Loc.Instance}, Path=[SettingsTitle]}" />
            </WrapPanel>
        </Border>

        <!-- ============ Status bar ============ -->
        <Border DockPanel.Dock="Bottom" Background="#F6F8FA" Padding="10,5"
                BorderBrush="#D8DEE4" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <ProgressBar Width="110" Height="12" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#57606A" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding SelectedNode.FullPath}"
                           Foreground="#57606A" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============ Main area ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" Grid.Column="0"
                      BorderThickness="0" Padding="6"
                      ItemsSource="{Binding RootNodes}"
                      ItemTemplate="{StaticResource FolderTemplate}"
                      SelectedItemChanged="FolderTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#E4E8ED" />

            <!-- Preview pane: thumbnails, or a detail list in "only details" mode -->
            <Grid Grid.Column="2" Background="White">

                <!-- Thumbnail grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDetailsMode}" Value="False" />
                                        <Condition Binding="{Binding HasSvgFiles}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <ItemsControl ItemsSource="{Binding SvgFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SvgFileViewModel}">
                                <Border Margin="6" Padding="8" CornerRadius="6"
                                        BorderBrush="#E4E8ED" BorderThickness="1"
                                        Background="#FCFDFE"
                                        Cursor="Hand"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ContextMenu="{StaticResource SvgItemContextMenu}"
                                        PreviewMouseLeftButtonDown="Thumbnail_MouseDown"
                                        ToolTip="{Binding ToolTipText}">
                                    <StackPanel Width="{Binding DataContext.ThumbnailSize,
                                                                RelativeSource={RelativeSource AncestorType=Window}}">

                                        <!-- Fixed-size cell so the grid stays aligned -->
                                        <Grid Height="{Binding DataContext.ThumbnailSize,
                                                               RelativeSource={RelativeSource AncestorType=Window}}">

                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                            <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[PreviewRenderFailed]}"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       FontSize="11" Foreground="#B42318"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding RenderFailed, Converter={StaticResource BoolToVisibility}}" />

                                            <ProgressBar Height="3" Width="40" IsIndeterminate="True"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsLoadingThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <TextBlock Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   Margin="0,6,0,0" FontSize="11" Foreground="#24292F" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Detail list -->
                <ListView ItemsSource="{Binding SvgFiles}" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="ContextMenu" Value="{StaticResource SvgItemContextMenu}" />
                            <EventSetter Event="MouseDoubleClick" Handler="ListItem_DoubleClick" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDetailsMode}" Value="True" />
                                        <Condition Binding="{Binding HasSvgFiles}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="320"
                                            Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[ColumnName]}"
                                            DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Width="110"
                                            Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[ColumnSize]}"
                                            DisplayMemberBinding="{Binding SizeDisplay}" />
                            <GridViewColumn Width="170"
                                            Header="{Binding Source={x:Static loc:Loc.Instance}, Path=[ColumnModified]}"
                                            DisplayMemberBinding="{Binding LastModifiedDisplay}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Placeholder messages -->
                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[PreviewSelectFolder]}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#8B949E"
                           Visibility="{Binding ShowsNoSelectionMessage, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowsEmptyFolderMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SelectedNode.DisplayName}"
                               FontSize="14" Foreground="#24292F"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[PreviewNoSvgFiles]}"
                               Foreground="#8B949E" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
        </DockPanel>

        <!-- Zoomable full-window overlay, shown when a thumbnail is opened -->
        <views:SvgZoomViewer x:Name="ZoomViewer" />
    </Grid>
</Window>
