<Window x:Class="SVGViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SVGViewer.Localization"
        xmlns:vm="clr-namespace:SVGViewer.ViewModels"
        Title="{Binding Source={x:Static loc:Loc.Instance}, Path=[AppTitle]}"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="SvgAccentBrush" Color="#1F6FEB" />
        <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#E3EDFD" />

        <!-- A folder node in the tree; highlighted when it contains SVG files -->
        <HierarchicalDataTemplate x:Key="FolderTemplate"
                                  DataType="{x:Type vm:DirectoryNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="&#x1F4C1;" Margin="0,0,5,0" FontSize="13" />

                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#24292F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSvgFiles}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{StaticResource SvgAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Margin="6,0,0,0" Padding="5,0" CornerRadius="8"
                        Background="{StaticResource BadgeBackgroundBrush}"
                        ToolTip="{Binding SvgTooltip}"
                        Visibility="{Binding HasSvgFiles, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SvgFileCount}" FontSize="11"
                               Foreground="{StaticResource SvgAccentBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ============ Toolbar ============ -->
        <Border DockPanel.Dock="Top" Background="#F6F8FA" Padding="10,8"
                BorderBrush="#D8DEE4" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">

                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[LabelDrive]}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="190" Margin="0,0,18,0"
                          ItemsSource="{Binding Drives}"
                          SelectedItem="{Binding SelectedDrive}"
                          DisplayMemberPath="DisplayName" />

                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[LabelView]}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="200" Margin="0,0,18,0"
                          ItemsSource="{Binding FilterChoices}"
                          SelectedItem="{Binding SelectedFilter}"
                          DisplayMemberPath="DisplayName" />

                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[LabelPreviewSize]}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="140" Margin="0,0,18,0"
                          ItemsSource="{Binding PreviewSizeChoices}"
                          SelectedItem="{Binding SelectedPreviewSize}"
                          DisplayMemberPath="DisplayName" />

                <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[LabelLanguage]}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Width="120" Margin="0,0,18,0"
                          ItemsSource="{Binding LanguageChoices}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="DisplayName" />

                <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonRefresh]}"
                        Command="{Binding RefreshCommand}"
                        Padding="12,3" Margin="0,0,8,0" />

                <Button Content="{Binding Source={x:Static loc:Loc.Instance}, Path=[ButtonCancel]}"
                        Command="{Binding CancelScanCommand}"
                        Padding="12,3"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Border>

        <!-- ============ Status bar ============ -->
        <Border DockPanel.Dock="Bottom" Background="#F6F8FA" Padding="10,5"
                BorderBrush="#D8DEE4" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <ProgressBar Width="110" Height="12" IsIndeterminate="True" Margin="0,0,8,0"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#57606A" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding SelectedNode.FullPath}"
                           Foreground="#57606A" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============ Main area ============ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" Grid.Column="0"
                      BorderThickness="0" Padding="6"
                      ItemsSource="{Binding RootNodes}"
                      ItemTemplate="{StaticResource FolderTemplate}"
                      SelectedItemChanged="FolderTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#E4E8ED" />

            <!-- Preview pane: filled in milestone 3 -->
            <Border Grid.Column="2" Background="White">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectedFolderInfo}"
                               FontSize="14" Foreground="#24292F"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Source={x:Static loc:Loc.Instance}, Path=[PreviewComingSoon]}"
                               Foreground="#8B949E" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
